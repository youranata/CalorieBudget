<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日剩余" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/widget_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2000" android:textColor="@color/calorie_primary" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_remaining_kj" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="约 8368 kJ" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/widget_consumed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="已摄入 0 / 2000 kcal" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/widget_add_kcal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ kcal" android:textSize="11sp" android:minHeight="36dp" />
        <Button android:id="@+id/widget_add_kj" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ kJ" android:textSize="11sp" android:minHeight="36dp" />
        <Button android:id="@+id/widget_add_note" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="记录" android:textSize="11sp" android:minHeight="36dp" />
    </LinearLayout>
</LinearLayout>
