<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:layout_marginTop="8dp" android:background="@drawable/card_background">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/record_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:30" android:textStyle="bold" />
        <TextView android:id="@+id/record_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="早餐" android:textColor="@color/text_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/record_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="350 kcal" android:textStyle="bold" />
    <ImageButton android:id="@+id/edit_record" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_edit" android:contentDescription="编辑" android:background="?attr/selectableItemBackgroundBorderless" />
    <ImageButton android:id="@+id/delete_record" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_delete" android:contentDescription="删除" android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
