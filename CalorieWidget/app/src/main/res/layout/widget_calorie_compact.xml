<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:contentDescription="@string/widget_calorie_contentdescription_1">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_calorie_text_2" android:textColor="@color/text_secondary" android:textSize="10sp" />
        <TextView android:id="@+id/widget_remaining" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="26dp" android:text="@string/activity_main_text_2" android:textColor="@color/calorie_primary" android:textSize="27sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="27sp" />
        <TextView android:id="@+id/widget_remaining_kj" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_calorie_text_3" android:textColor="@color/text_secondary" android:textSize="10sp" />
        <TextView android:id="@+id/widget_consumed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_calorie_text_4" android:textColor="@color/text_secondary" android:textSize="10sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_add_kcal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/widget_calorie_text_5" android:textColor="@color/calorie_primary" android:textSize="12sp" android:background="@drawable/card_background" android:contentDescription="@string/widget_calorie_contentdescription_6" />
        <TextView android:id="@+id/widget_add_kj" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="@string/widget_calorie_text_7" android:textColor="@color/calorie_primary" android:textSize="12sp" android:background="@drawable/card_background" android:contentDescription="@string/widget_calorie_contentdescription_8" />
    </LinearLayout>
    <TextView android:id="@+id/widget_add_note" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="@string/widget_calorie_text_9" android:textColor="@color/calorie_primary" android:textSize="11sp" android:contentDescription="@string/widget_calorie_contentdescription_10" />
</LinearLayout>
