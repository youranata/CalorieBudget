<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="12dp" android:background="@drawable/card_background">
    <TextView android:id="@+id/day_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_day_summary_text_1" android:textSize="12sp" android:textStyle="normal" android:fontFamily="sans-serif-medium" android:textColor="@color/mist_ink" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/mist_background" />
    <TextView android:id="@+id/day_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_day_summary_text_2" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginTop="16dp" android:textSize="22sp" android:fontFeatureSettings="tnum" android:letterSpacing="-0.02" />
    <TextView android:id="@+id/day_budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_day_summary_text_3" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:layout_marginTop="8dp" android:textSize="13sp" />
    <TextView android:id="@+id/day_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_day_summary_text_4" android:textColor="@color/calorie_primary" android:fontFamily="sans-serif" android:layout_marginTop="8dp" android:textSize="13sp" />
</LinearLayout>