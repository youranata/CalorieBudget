<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/card_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/record_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_record_text_1" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/record_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/item_record_text_2" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:layout_marginTop="8dp" android:textSize="16sp" android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/record_original" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:id="@+id/record_amount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="@string/item_record_text_3" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/calorie_primary" android:layout_weight="1" android:textSize="20sp" android:fontFeatureSettings="tnum" />
        <ImageButton android:id="@+id/edit_record" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_edit" android:contentDescription="@string/item_record_contentdescription_4" android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/delete_record" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_delete" android:contentDescription="@string/delete" android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
