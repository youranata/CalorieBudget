<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/summary_background">
            <TextView android:id="@+id/today_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_text_1" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif" android:letterSpacing="0.03" />
            <TextView android:id="@+id/remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/activity_main_text_2" android:textSize="48sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/calorie_primary" android:fontFeatureSettings="tnum" android:letterSpacing="-0.025" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_text_3" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" />
            <TextView android:id="@+id/remaining_kj" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_text_4" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/consumed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/activity_main_text_5" android:textSize="16sp" android:fontFamily="sans-serif" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_text_6" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="sans-serif" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
            <Button android:id="@+id/add_record_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/activity_main_text_7" style="@style/Widget.Calorie.Button" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/budget_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/activity_main_text_8" style="@style/Widget.Calorie.Button.Secondary" android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/history_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/activity_history_text_1" style="@style/Widget.Calorie.Button.Secondary" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/stats_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/activity_main_text_9" style="@style/Widget.Calorie.Button.Secondary" android:layout_marginStart="4dp" />
        </LinearLayout>
        <Button android:id="@+id/alarm_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_text_10" style="@style/Widget.Calorie.Button.Quiet" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/activity_main_text_11" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/activity_main_text_12" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:padding="20dp" android:background="@drawable/card_background" android:lineSpacingExtra="4dp" />
        <LinearLayout android:id="@+id/records_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
