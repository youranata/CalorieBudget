<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/back_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_day_detail_text_1" style="@style/Widget.Calorie.Button.Quiet" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="center_vertical" android:layout_marginStart="12dp" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
        <Button android:id="@+id/add_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_day_detail_text_2" style="@style/Widget.Calorie.Button" />
    </LinearLayout>
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:padding="20dp" android:background="@drawable/summary_background" android:lineSpacingExtra="8dp" android:textSize="16sp" />
    <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="@string/activity_day_detail_text_3" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:layout_marginTop="12dp" android:background="@drawable/card_background" android:lineSpacingExtra="4dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/records_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
