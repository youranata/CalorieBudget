<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Widget.Calorie.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/button_primary_tint</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
    <style name="Widget.Calorie.Button.Secondary" parent="Widget.Calorie.Button">
        <item name="backgroundTint">@color/button_secondary_tint</item>
        <item name="android:textColor">@color/calorie_primary</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Calorie.Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
    <style name="Widget.Calorie.Button.Range" parent="Widget.Calorie.Button.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/mist_surface</item>
        <item name="android:textColor">@color/mist_ink</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Calorie.Button.Mist" parent="Widget.Calorie.Button.Secondary">
        <item name="backgroundTint">@color/mist_surface</item>
        <item name="android:textColor">@color/mist_ink</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Calorie.Button.Sand" parent="Widget.Calorie.Button.Secondary">
        <item name="backgroundTint">@color/sand_surface</item>
        <item name="android:textColor">@color/sand_ink</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Calorie.Button.Mauve" parent="Widget.Calorie.Button.Secondary">
        <item name="backgroundTint">@color/mauve_surface</item>
        <item name="android:textColor">@color/mauve_ink</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Calorie.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/calorie_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Calorie.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="ShapeAppearance.Calorie" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
</resources>
